# Copy to .env for local dev. NEVER commit the real .env (it is gitignored).

# Optional: only needed so report-hub (or any other headless caller) can
# generate reports without a human pasting Tenant ID/Client ID/Client Secret
# into the browser each time. The existing browser flow (index.html) works
# with no env vars at all -- this is purely additive.
#
# JSON array, one entry per client that has completed the per-tenant Entra ID
# app registration in docs/Setup_Guide.docx. See config/clients.example.json
# for the shape (optional per-client "skipOverseas": true leaves the overseas
# sign-in check out). Keep this as a single-line JSON string.
INTUNE_CLIENTS_JSON=[]

# Microsoft staff sign-in (same Entra single-page-app registration as the dashboard).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Comma-separated staff email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=integricity.co.nz
# Random 32+ character secret that signs the staff session cookie.
SESSION_JWT_SECRET=
# Temporary: true leaves intune / export-docx / export-pdf open. Remove to enforce sign-in.
APP_ACCESS_DISABLED=

# Shared secret report-hub sends as the x-report-hub-key header to the clients,
# report-data, export-docx and export-pdf functions. Every call is refused while this
# is unset. Use the same value in report-hub's own environment. One secret, not
# one per client.
REPORT_HUB_SHARED_KEY=

# Optional. Enables the admin-only delete-client-metrics function, which deletes a
# tenant's stored month-on-month figures on request (sent as x-admin-key). Every
# call is refused while this is unset. Netlify Blobs itself needs no variables.
ARCHIVE_ADMIN_KEY=
